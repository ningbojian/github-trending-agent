{
  "name": "github-trending-agent",
  "version": "0.1.0",
  "private": true,
  "description": "基于企业微信的对话式 GitHub Trending 助手",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vercel dev",
    "dev:panel": "tsx scripts/dev-panel.ts",
    "email:preview": "tsx scripts/email-preview.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:audit": "tsx scripts/db-audit.ts",
    "eval": "tsx evals/cli.ts --compare",
    "eval:ci": "tsx evals/cli.ts --compare",
    "eval:llm": "tsx evals/cli.ts --llm --compare",
    "eval:baseline": "tsx evals/cli.ts --update-baseline",
    "eval:seed": "tsx evals/seed-from-intent-log.ts",
    "sources:run": "tsx src/sources/run-sources.ts"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.73",
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/deepseek": "^3.0.70",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.10.3",
    "ai": "^7.0.148",
    "drizzle-orm": "^0.45.4",
    "node-html-parser": "^9.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@ai-sdk/provider": "4.0.34",
    "@ai-sdk/provider-utils": "5.0.68"
  }
}
