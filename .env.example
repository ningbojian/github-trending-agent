# ===== Neon Postgres（连接串，HTTP driver；本地迁移 + Vercel + Actions 三处同值）=====
# 必填
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# ===== LLM 提供商（Vercel 必填；Actions 侧由 workflow 填占位）=====
# 必填：anthropic | openai | deepseek | ali
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-your-api-key
LLM_MODEL=claude-sonnet-4-5

# ===== 企业微信自建应用（Vercel + Actions，见 docs/deploy.md 第 2/3/5 步）=====
# 必填：企业 ID
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
# 必填：自建应用 AgentId，纯数字字符串（Vercel Number() / Actions jq tonumber 双重要求）
WECOM_AGENT_ID=1000001
# 必填：自建应用 Secret
WECOM_SECRET=your-wecom-app-secret
# 必填：接收消息回调 Token（与企微后台"接收消息服务器配置"逐字一致；仅 Vercel）
WECOM_CALLBACK_TOKEN=your-callback-token
# 必填：接收消息回调 EncodingAESKey，43 位（与企微后台逐字一致；仅 Vercel）
WECOM_CALLBACK_AES_KEY=your-43-char-base64-aes-key
# 可选：管理员 userid，用于每日管线失败告警（不配则告警步骤跳过）
WECOM_ADMIN_USERID=admin-userid

# ===== GitHub OAuth App（仅 Vercel；授权 scope 固定 public_repo）=====
# 必填：OAuth App Client ID
GITHUB_CLIENT_ID=Iv1xxxxxxxxxxxx
# 必填：OAuth App Client Secret
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# 必填：回调地址，须与 OAuth App 登记的 Authorization callback URL 逐字一致
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/oauth-github
# 可选：服务端 GitHub token，补全 topics 时提高 API 限额（不配也可运行）
GITHUB_TOKEN=

# ===== 安全 =====
# 必填：简报端点 Bearer 口令（Vercel 与 Actions 同值）
CRON_SECRET=long-random-string-for-cron-auth
# 必填：用户 GitHub token 加密密钥（openssl rand -hex 32；仅 Vercel，绝不下放到 Actions）
TOKEN_ENCRYPT_KEY=32-byte-hex-or-long-random-string
