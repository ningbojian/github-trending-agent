# Neon Postgres 连接串（HTTP driver）
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# LLM 提供商（anthropic | openai | deepseek | ali）
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-your-api-key
LLM_MODEL=claude-sonnet-4-5

# 企业微信自建应用
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000001
WECOM_SECRET=your-wecom-app-secret
WECOM_CALLBACK_TOKEN=your-callback-token
WECOM_CALLBACK_AES_KEY=your-43-char-base64-aes-key
# 可选：管理员 userid，用于推送失败告警
WECOM_ADMIN_USERID=admin-userid

# GitHub OAuth App（scope 仅 public_repo）
GITHUB_CLIENT_ID=Iv1xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/github/callback
# 可选：服务端 GitHub token，用于补全 topics 时提高 API 限额
GITHUB_TOKEN=

# 安全
CRON_SECRET=long-random-string-for-cron-auth
TOKEN_ENCRYPT_KEY=32-byte-hex-or-long-random-string
